# Environment: local, development, staging, production
ENVIRONMENT=local

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=conduit
DATABASE_PASSWORD=conduit
DATABASE_NAME=conduit
DATABASE_SSL_MODE=disable
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONNS=10
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Observability
OTEL_SERVICE_NAME=conduit
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_METRICS_ENABLED=true
OTEL_TRACING_ENABLED=true
OTEL_TRACING_SAMPLE_RATE=1.0

# Security
SECURITY_CORS_ALLOWED_ORIGINS=*
SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
SECURITY_CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID,X-Tenant-ID
SECURITY_CORS_MAX_AGE=86400
SECURITY_RATE_LIMIT_RATE=100
SECURITY_RATE_LIMIT_BURST=200

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
